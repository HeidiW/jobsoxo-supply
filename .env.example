# Copy to .env.local for local development.

# Base URL for absolute links in the product feeds. Optional: on Vercel it
# falls back to the project's production URL, and locally to localhost:3000.
SITE_URL=http://localhost:3000

# Stripe TEST keys, from https://dashboard.stripe.com/test/apikeys
# Leave these blank to use the mock payment form. Live keys are ignored.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
